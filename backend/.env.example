ANTHROPIC_API_KEY=your-api-key-here
DATABASE_URL=sqlite:///./ticket_sim.db

# Set to true to run entirely on canned/scripted responses (no real Claude API
# calls at all) — used for public demo deployments. Leave false for normal use.
DEMO_MODE=false

# Comma-separated list of origins the frontend is allowed to call this API from.
ALLOWED_ORIGINS=http://localhost:3000
